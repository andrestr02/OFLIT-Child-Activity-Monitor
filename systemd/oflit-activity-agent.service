[Unit]
Description=OFLIT Child Activity Monitor agent
Documentation=file:/opt/oflit-child-activity-monitor/docs/OPERATIONS.md
After=systemd-logind.service network-online.target
Wants=network-online.target
# The monitor must never be a dependency for child login/logout. Do NOT let
# any getty/gdm/user session require this unit.

[Service]
Type=simple
ExecStart=/opt/oflit-child-activity-monitor/bin/oflit-activity-agent
Environment=OFLIT_ACTIVITY_CONFIG=/etc/oflit-activity/agent.conf
Restart=always
RestartSec=3
# Give the agent time to finalize open sessions + enqueue final reports on stop
# (logout / shutdown with an active child session).
TimeoutStopSec=25
KillSignal=SIGTERM

# --- hardening (runs as root: needs the root-owned DB, cross-user process
#     sampling, and read access to the root-owned Squid log) ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/oflit-activity
ProtectHome=read-only
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
